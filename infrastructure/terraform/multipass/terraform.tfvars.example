# Copy this file to terraform.tfvars only when you want to override the defaults.
ubuntu_image = "24.04"
ansible_public_key_path = "~/.ssh/id_ed25519.pub"

nodes = {
  k3s-server-1 = {
    role   = "server"
    cpus   = 2
    memory = "4GiB"
    disk   = "20GiB"
  }
  k3s-worker-1 = {
    role   = "agent"
    cpus   = 2
    memory = "2GiB"
    disk   = "15GiB"
  }
  k3s-worker-2 = {
    role   = "agent"
    cpus   = 2
    memory = "2GiB"
    disk   = "15GiB"
  }
}
